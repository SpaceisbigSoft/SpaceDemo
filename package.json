{
  "name": "cs-demo-fixer",
  "version": "0.0.1",
  "private": true,
  "description": "Repair and play old Counter-Strike 1.0-1.6 demos with voice in modern CS 1.6",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/SpaceisbigSoft/i69-demoviewer"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "inspect": "tsx tools/inspect.ts",
    "convert": "tsx tools/convert.ts",
    "match": "tsx tools/match.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
